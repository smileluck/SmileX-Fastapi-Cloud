{
  "version": "0.2.0",
  "configurations": [
    // 后端FastAPI启动配置 (使用uvicorn)
    {
      "name": "后端 - FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.dev",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },

    // 前端Vue启动配置
    {
      "name": "前端 - Vue",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:9527",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    },

    // 前端TypeScript调试
    {
      "name": "前端 - TS Debugger",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/frontend/node_modules/**"],
      "program": "${file}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}