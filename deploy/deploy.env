# SmileX Cloud Backend 部署配置
# 修改以下变量以匹配你的服务器环境

# ---- 应用 ----
APP_NAME="smilex-cloud"
APP_USER="smilex"
APP_GROUP="smilex"

# 项目根目录（不含 backend/）
PROJECT_DIR="/opt/smilex-cloud"

# 后端目录
BACKEND_DIR="${PROJECT_DIR}/backend"

# Python 虚拟环境目录
VENV_DIR="${BACKEND_DIR}/.venv"

# ---- Gunicorn ----
GUNICORN_WORKERS=4
GUNICORN_PORT=8000
GUNICORN_BIND="0.0.0.0:${GUNICORN_PORT}"
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=5000
GUNICORN_MAX_REQUESTS_JITTER=500
GUNICORN_CONFIG="${BACKEND_DIR}/gunicorn.conf.py"

# ---- 日志 ----
# 应用日志与 Gunicorn access/error 日志统一按 LOG_DIR/YYYY-MM-DD/ 目录滚动
LOG_DIR="/var/log/smilex_cloud"

# ---- 环境 ----
ENV_FILE="${BACKEND_DIR}/.env.prod"

# ---- Git ----
GIT_BRANCH="main"

# ---- 健康检查 ----
# 使用就绪探针（readiness）：检查 DB + Redis 是否就绪，比 liveness 更能反映服务可用性。
# 注意：原 /openapi.json 在生产环境（ENVIR=prod 且 OPENAPI_ENABLE_IN_PROD=false）被禁用，会导致健康检查恒 404。
HEALTH_CHECK_URL="http://127.0.0.1:${GUNICORN_PORT}/admin/sys/ready"
HEALTH_CHECK_TIMEOUT=10
