# .env
ENVIR=dev

DATABASE__TYPE=postgresql
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5432
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=123456
DATABASE__DATABASE=smilex_cloud
DATABASE__ECHO=True

JWT__SECRET_KEY=smilexcloud123456
JWT__ALGORITHM=HS256
JWT__ACCESS_LIFETIME=7200
JWT__REFRESH_LIFETIME=604800


SECURITY__ALLOWED_HOSTS=["localhost", "127.0.0.1", "*"]

# 存储配置
STORAGE__PLATFORM=local
UPLOAD_LOCAL__BASE_DIR=uploads
UPLOAD_LOCAL__MAX_FILE_SIZE=52428800
UPLOAD_LOCAL__ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","bmp","webp","svg","pdf","doc","docx","xls","xlsx","ppt","pptx","txt","csv","json","xml","zip","rar","7z","tar","gz","mp4","mp3","wav","avi","mov","wmv","flv","apk","exe","msi"]

# 插件配置
PLUGINS__ENABLED=[]
